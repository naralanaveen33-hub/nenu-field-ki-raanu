# ============================================================================
# Smart Farm Frontend (Vercel) - Environment Variables
# ============================================================================

# --- Public Frontend API Configuration ---
# Only public configuration may use NEXT_PUBLIC_*
# Development (local Flask backend):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
# Production (Raspberry Pi backend tunnel / domain):
NEXT_PUBLIC_API_URL=https://YOUR-RASPBERRY-PI-BACKEND-DOMAIN

# Telugu Voice & UI Language Settings
NEXT_PUBLIC_DEFAULT_LANGUAGE=te
NEXT_PUBLIC_ENABLE_AUDIO_SYNTHESIS=true

# --- Server-Side Only Configuration ---
# NEVER expose keys to the client with NEXT_PUBLIC_*!

# xAI Grok Conversational AI Chatbot (Server-Side Only)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest

# Optional Voice Synthesis (Server-Side Only)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Weather API (Open-Meteo free tier)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=30
