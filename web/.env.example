# ============================================================================
# Smart Farm Frontend (Vercel) - Environment Variables Template
# ============================================================================

# --- UI & Voice Settings ---
NEXT_PUBLIC_DEFAULT_LANGUAGE=te
NEXT_PUBLIC_ENABLE_AUDIO_SYNTHESIS=true

# --- xAI Grok Conversational Assistant (Server-Side Only - Never NEXT_PUBLIC_) ---
XAI_MODEL=grok-2-latest
XAI_API_KEY=your_xai_api_key_here

# --- Raspberry Pi Backend (Do NOT set on Vercel yet until Pi HTTPS URL is live) ---
# NEXT_PUBLIC_API_URL=https://YOUR-RASPBERRY-PI-BACKEND-DOMAIN
