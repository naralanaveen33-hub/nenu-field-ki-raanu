# ============================================================================
# Smart Farm Raspberry Pi Backend - Environment Configuration Template
# ============================================================================

# Backend Server Configuration
HOST=0.0.0.0
BACKEND_PORT=5000

# Arduino USB Serial Connection (9600 baud protocol)
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=9600
DEMO_MODE=true

# Weather API (Open-Meteo free tier)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LAT=17.3850
WEATHER_LON=78.4867

# CORS Allowed Origins (Comma-separated Vercel frontend URLs)
CORS_ORIGINS=https://nenu-field-ki-raanu.vercel.app,https://nenu-field-ki-raanu-rio8y49y5-naralanaveen33-hubs-projects.vercel.app,http://localhost:3000

# xAI Grok Conversational Assistant (Server-Side Only)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest
